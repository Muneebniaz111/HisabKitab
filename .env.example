# Supabase Postgres connection strings (Supabase → Connect).
# DATABASE_URL: the transaction pooler (port 6543) — needed on Vercel, where
# every serverless function opens its own connection.
# DIRECT_URL: the session pooler or direct connection (port 5432) — used by
# `prisma migrate`, which can't run through the transaction pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# Signs the idle-timeout cookie (lib/idle-session.ts). Any long random string.
SESSION_SECRET="[RANDOM_SECRET]"

# Minutes of inactivity before a user is signed out (default 15). Users get a
# 60-second warning with a "Stay signed in" button first.
IDLE_TIMEOUT_MINUTES="15"

# Shared secret for /api/cron/process-recurring — set the same value here
# and in your scheduler's Authorization: Bearer header (Vercel Cron adds
# this automatically when CRON_SECRET is set as a project env var).
CRON_SECRET="[RANDOM_SECRET]"

# Email notifications (income/expense/transfer/savings, weekly savings
# digest, recurring-due-soon reminders) — resend.com, free tier is fine.
# Get RESEND_API_KEY from Resend's dashboard. Leaving this unset doesn't
# break anything — lib/email/client.ts no-ops and logs a warning instead
# of throwing, so the app runs fine without email configured.
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend, OR leave this as-is to
# send from Resend's shared test domain (fine for development; a real
# domain is worth setting up before relying on this for anything you
# don't want landing in spam).
EMAIL_FROM="Hisab-Kitab <onboarding@resend.dev>"

